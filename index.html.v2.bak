<!-- ============ MODAL ============ -->
<div id="scrim"></div>
<div id="modal" role="dialog" aria-modal="true">
  <div id="mHead">
    <div><div class="mk" id="mKick"></div><h2 id="mTitle"></h2></div>
    <div class="mcount" id="mCount"></div>
    <button id="mClose" aria-label="Close">✕</button>
  </div>
  <div id="mBody"><div id="mSlide"><div id="mArt"></div><div id="mText"></div></div></div>
  <div id="mFoot">
    <button class="mnav" id="mPrev">← PREV</button>
    <button class="mnav" id="mNext">NEXT →</button>
    <div id="mDots"></div>
    <button id="mCta"></button>
  </div>
</div>

