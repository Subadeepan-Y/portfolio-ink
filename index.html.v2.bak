<!-- ============ 00 HERO ============ -->
<section class="chapter" id="hero">
  <div id="sky"></div>
  <div id="stars"></div>
  <div id="moon"></div>
  <svg id="ridges" viewBox="0 0 1200 300" preserveAspectRatio="none">
    <path d="M0,220 L140,120 L260,190 L400,90 L540,200 L700,110 L840,200 L980,130 L1120,210 L1200,170 L1200,300 L0,300 Z" fill="#4A2A3C" opacity=".85"/>
    <path d="M0,300 L0,250 L180,170 L340,240 L520,150 L700,250 L880,180 L1040,250 L1200,210 L1200,300 Z" fill="#2C1526"/>
    <path d="M0,300 L0,280 L240,230 L480,285 L760,235 L1000,285 L1200,260 L1200,300 Z" fill="#1B0C17"/>
