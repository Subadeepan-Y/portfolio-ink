/* ================= RENDER LIST ================= */
const list = document.getElementById('projList');
if (list) {
  PROJECTS.forEach((p, i) => {
  const b = document.createElement('button');
  b.className = 'proj reveal';
  b.innerHTML = `<h3>${p.name}</h3><p>${p.sub}</p>
    <div class="tags">${p.tags.map(t => `<span class="pill">${t}</span>`).join('')}
    <span class="badge ${p.badge[1]}">${p.badge[0]}</span><span class="open-hint">OPEN →</span></div>`;
  b.onclick = () => openModal(i);
  list.appendChild(b);
  });
}

/* ================= MODAL ================= */
const scrim = document.getElementById('scrim'), modal = document.getElementById('modal');
const mKick = document.getElementById('mKick'), mTitle = document.getElementById('mTitle'),
      mCount = document.getElementById('mCount'), mArt = document.getElementById('mArt'),
      mText = document.getElementById('mText'), mDots = document.getElementById('mDots'),
      mCta = document.getElementById('mCta'),
      mPrev = document.getElementById('mPrev'), mNext = document.getElementById('mNext');
let cur = 0, slide = 0;

function openModal(i) {
  cur = i; slide = 0;
  const p = PROJECTS[cur];
  mKick.textContent = 'THE WORK — ' + p.name.toUpperCase();
  mTitle.textContent = p.name;
  scrim.classList.add('open'); modal.classList.add('open');
  document.body.style.overflow = 'hidden';
  paint();
}
function closeModal() {
  scrim.classList.remove('open'); modal.classList.remove('open');
  document.body.style.overflow = '';
}
function paint() {
  const p = PROJECTS[cur], s = p.slides[slide], last = slide === p.slides.length - 1;
  mArt.innerHTML = s.art;
  const specsHtml = Array.isArray(s.specs) && s.specs.length
    ? `<ul class="specs">${s.specs.map((item) => `<li>${item}</li>`).join('')}</ul>`
    : '';
  mText.innerHTML = `<div class="feat">${s.feature}</div><div class="desc">${s.desc}</div>${specsHtml}<span class="tech">${s.tech}</span>`;
  mCount.textContent = String(slide + 1).padStart(2, '0') + ' / ' + String(p.slides.length).padStart(2, '0');
  mDots.innerHTML = p.slides.map((_, j) => `<i class="${j === slide ? 'on' : ''}"></i>`).join('');
  mPrev.disabled = slide === 0;
  mNext.disabled = last;
  mCta.className = '';
  if (last) {
    if (p.cta) {
      mCta.textContent = p.cta.label;
      mCta.classList.add('show');
      mCta.onclick = () => window.open(p.cta.href, '_blank', 'noopener');
    } else {
      mCta.textContent = '🔒 ' + (p.note || 'Private project');
      mCta.classList.add('show', 'ghost');
      mCta.onclick = null;
    }
  }
  document.getElementById('mSlide').scrollTop = 0;
}
mPrev.onclick = () => { if (slide > 0) { slide--; paint(); } };
mNext.onclick = () => { const p = PROJECTS[cur]; if (slide < p.slides.length - 1) { slide++; paint(); } };
document.getElementById('mClose').onclick = closeModal;
scrim.onclick = closeModal;
document.addEventListener('keydown', (e) => {
  if (!modal.classList.contains('open')) return;
  if (e.key === 'Escape') closeModal();
  if (e.key === 'ArrowRight') mNext.onclick();
  if (e.key === 'ArrowLeft') mPrev.onclick();
});

/* ================= LEAVES ================= */
(function () {
  const box = document.getElementById('leaves');
  const reds = ['#c0392b', '#991b1b', '#e05545', '#8f2b1f', '#D9A2B0'];
  for (let i = 0; i < 18; i++) {
    const d = document.createElement('div');
    d.className = 'leaf';
    const size = 9 + Math.random() * 13;
    d.innerHTML = `<div><svg width="${size.toFixed(0)}" height="${size.toFixed(0)}" viewBox="0 0 24 24">
      <path d="M12 1 L14 8 L21 7 L16 12 L21 17 L14 16 L12 23 L10 16 L3 17 L8 12 L3 7 L10 8 Z"
      fill="${reds[i % reds.length]}" opacity="${(0.35 + Math.random() * 0.45).toFixed(2)}"/></svg></div>`;
    d.style.left = (Math.random() * 100) + 'vw';
    const fall = 8 + Math.random() * 10;
    d.style.animationDuration = fall.toFixed(1) + 's';
    d.style.animationDelay = (-Math.random() * fall).toFixed(1) + 's';
    d.firstChild.style.animationDuration = (2 + Math.random() * 3).toFixed(1) + 's';
    box.appendChild(d);
  }
})();

/* ================= CHAPTER TRACKING ================= */
(function () {
  const links = document.querySelectorAll('#chapters a, #topnav a');
  const secs = ['hero', 'about', 'work', 'process', 'contact'];
  const byId = {};
  secs.forEach((s) => { byId[s] = document.getElementById(s); });
  function paint() {
    const y = window.innerHeight * 0.45;
    let c = 'hero';
    secs.forEach((s) => { if (byId[s].getBoundingClientRect().top <= y) c = s; });
    links.forEach((a) => a.classList.toggle('on', a.dataset.ch === c));
  }
  window.addEventListener('scroll', paint, { passive: true });
  paint();
})();

/* ================= REVEAL ================= */
(function () {
  const reveals = document.querySelectorAll('.reveal');
  let lastScrollY = window.scrollY;
  let lastRevealTime = 0;
  let ticking = false;

  function update() {
    const currentY = window.scrollY;
    const isScrollingUp = currentY < lastScrollY;
    const vh = window.innerHeight;
    const now = performance.now();

    if (isScrollingUp) {
      lastRevealTime = 0;
    }

    reveals.forEach((el) => {
      const rect = el.getBoundingClientRect();

      if (isScrollingUp) {
        // Disappear when scrolling up past element
        if (rect.top >= vh * 0.88) {
          if (el.classList.contains('in')) {
            el.style.transitionDelay = '0s';
            el.classList.remove('in');
          }
        } else if (rect.bottom >= 0) {
          if (!el.classList.contains('in')) {
            el.style.transitionDelay = '0s';
            el.classList.add('in');
          }
        }
      } else {
        // Reveal one by one when scrolling down
        if (rect.top <= vh * 0.86 && rect.bottom >= 0) {
          if (!el.classList.contains('in')) {
            if (lastRevealTime < now) lastRevealTime = now;
            const delay = Math.min(Math.round(lastRevealTime - now), 800);
            el.style.transitionDelay = delay + 'ms';
            el.classList.add('in');
            lastRevealTime += 130;
          }
        } else if (rect.top > vh) {
          if (el.classList.contains('in')) {
            el.style.transitionDelay = '0s';
            el.classList.remove('in');
          }
        }
      }
    });

    lastScrollY = currentY;
    ticking = false;
  }

  function onScroll() {
    if (!ticking) {
      requestAnimationFrame(update);
      ticking = true;
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  update();
})();

/* ================= MOON DRIFT ================= */
(function () {
  const moon = document.getElementById('moon');
  window.addEventListener('scroll', () => {
    moon.style.transform = 'translateY(' + Math.min(window.scrollY * 0.12, 220).toFixed(0) + 'px)';
  }, { passive: true });
})();

/* ================= BACKGROUND AUDIO ================= */
(function () {
  const bgm = document.getElementById('bgm');
  const btn = document.getElementById('soundBtn');
  if (!bgm || !btn) return;

  const MILD_VOL = 0.33;
  bgm.volume = MILD_VOL;
  bgm.muted = false;

  // Clear any stale muted flag so fresh visits always play by default
  try { localStorage.removeItem('suba_bgm_muted'); } catch (e) {}

  let userMuted = false;

  function syncUI() {
    btn.classList.toggle('muted', userMuted);
    const label = userMuted ? 'Play background music' : 'Mute background music';
    btn.setAttribute('aria-label', label);
    btn.title = label;
  }

  function startPlayback() {
    if (userMuted) return;
    bgm.muted = false;
    bgm.volume = MILD_VOL;
    const playPromise = bgm.play();
    if (playPromise !== undefined) {
      playPromise.catch(() => {});
    }
  }

  // Attempt immediate playback on entry
  startPlayback();

  // Also bind to any early user gesture so playback begins the moment the user touches, scrolls, or clicks
  const unlockEvents = ['pointerdown', 'touchstart', 'click', 'scroll', 'wheel', 'keydown'];
  function onFirstGesture() {
    startPlayback();
    unlockEvents.forEach((evt) => {
      window.removeEventListener(evt, onFirstGesture, { capture: true });
      document.removeEventListener(evt, onFirstGesture, { capture: true });
    });
  }
  unlockEvents.forEach((evt) => {
    window.addEventListener(evt, onFirstGesture, { capture: true, passive: true });
    document.addEventListener(evt, onFirstGesture, { capture: true, passive: true });
  });

  // Top-right mute/unmute button
  btn.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    if (!userMuted) {
      userMuted = true;
      bgm.muted = true;
      bgm.pause();
    } else {
      userMuted = false;
      bgm.muted = false;
      bgm.volume = MILD_VOL;
      bgm.play().catch(() => {});
    }
    syncUI();
  });

  syncUI();
})();
</script>
<script src="kage-scroll-engine.js"></script>
</body>
</html>
