</section>

<!-- ============ 01 ABOUT ============ -->
<section class="chapter" id="about">
  <div class="kanji">道</div>
  <div id="aboutInner">
    <div id="aboutText">
      <div class="clabel reveal">THE MAKER</div>
      <p class="big reveal">“I build tools other people wish existed. From AI tutors to animation engines to game compilers — <em>everything ships from scratch.</em>”</p>
      <div class="cols2 reveal">
        <div>
          <h4>SHIPPED &amp; BUILDING</h4>
          <ul><li>iGradeify</li><li>manim-ts</li><li>Duel Deck</li><li>Desktop Buddy &amp; Greate</li></ul>
        </div>
        <div>
          <h4>STACK</h4>
          <ul><li>TypeScript</li><li>React</li><li>Node</li><li>Supabase</li><li>Canvas API</li></ul>
        </div>
      </div>
    </div>
    <div id="portrait" class="reveal"><div class="ring">影</div></div>
  </div>
</section>

<!-- ============ 02 WORK ============ -->
<section id="work" class="chapter kage-work-track">
<!-- =========================================================================
     KAGE-INSPIRED CINEMATIC PROJECT STAGE CARDS (6 PROJECTS)
     Designed for d:/PROJECTS/portfolio-ink/index.html
     Two-Column Balanced Layout:
       • Left/Center: High-Impact Visual Feature Stage (Framed screens, assets, interactive previews)
       • Right: Project Identity, Kanji Watermark, Plain-English Specs, Action CTAs
     ========================================================================= -->

<div class="stage-track" id="stageTrack">

  <!-- ==================== 01: iGradeify ==================== -->
  <article class="stage-card" id="stage-card-0" data-project="0" data-theme="igradeify">
    <!-- Visual Stage (Left / Center) -->
    <div class="stage-visual">
      <div class="stage-window">
        <div class="stage-window-bar">
          <div class="stage-dots"><i></i><i></i><i></i></div>
          <div class="stage-addr">igradeify.vercel.app · cbse-ai-study-workspace</div>
          <span class="stage-tag-badge">● LIVE 60FPS</span>
        </div>
        <div class="stage-window-body">
          <div class="stage-shot-composite igradeify-grid">
            <div class="shot-layer primary-shot">
              <img src="shots/landing.png" alt="iGradeify Study Hub and Landing" loading="lazy">
            </div>
            <div class="shot-layer float-shot float-left">
              <img src="shots/testgen.png" alt="CBSE 80-Mark Test Generator Configuration" loading="lazy">
              <span class="shot-mini-badge">80-Mark Blueprint</span>
            </div>
            <div class="shot-layer float-shot float-right">
              <img src="shots/paper.png" alt="Generated CBSE Practice Paper with Geometry Diagrams" loading="lazy">
              <span class="shot-mini-badge">Board Paper Generator</span>
            </div>
          </div>
          <div class="stage-feature-chips">
            <span class="chip">PDF Hub &amp; Multi-Chapter ZIPs</span>
            <span class="chip">Sections A–E Blueprint</span>
            <span class="chip">Animated Visual Explainer</span>
            <span class="chip">Voice Study Rooms</span>
          </div>
          <div class="stage-shot-caption">
            ● ACTUAL SCREENSHOTS — FULL CBSE STUDY WORKSPACE &amp; TEST ENGINE
          </div>
        </div>
      </div>
    </div>

    <!-- Info / Specs Stack (Right) -->
    <div class="stage-info">
      <div class="stage-header">
        <div class="stage-meta">
          <span class="stage-num">01 / 06</span>
          <span class="stage-kicker">EDTECH &amp; AI STUDY ECOSYSTEM</span>
        </div>
        <span class="stage-kanji">創</span>
      </div>

      <div class="stage-title-wrap">
        <h2 class="stage-title">iGradeify</h2>
        <span class="stage-status-badge live">● LIVE WEB APP</span>
      </div>

      <p class="stage-sub">
        An all-in-one CBSE study workspace that turns textbook PDFs and class notes into animated lessons, interactive concept mind maps, authentic 80-mark board papers, and collaborative live study rooms.
      </p>

      <div class="stage-specs">
        <div class="spec-item">
          <div class="spec-bullet"></div>
          <div class="spec-content">
            <h4>Full 80-Mark Board Paper Generator</h4>
            <p>Generates realistic CBSE 38-question practice papers across Sections A–E with authentic geometry diagrams, timed exam mode, and step-by-step marking rubrics.</p>
          </div>
        </div>
        <div class="spec-item">
          <div class="spec-bullet"></div>
          <div class="spec-content">
            <h4>Animated Visual Explainer &amp; Interactive Sims</h4>
            <p>Converts complex math, physics, and chemistry concepts into smooth, step-by-step vector animations and interactive simulations right inside the browser.</p>
          </div>
        </div>
        <div class="spec-item">
          <div class="spec-bullet"></div>
          <div class="spec-content">
            <h4>Live Study Rooms &amp; Infinite Whiteboard</h4>
            <p>Multiplayer study tables with 6-letter room codes, auto-snapping geometric shapes, one-tap color fills, PDF sharing, and built-in voice chat.</p>
          </div>
        </div>
        <div class="spec-item">
          <div class="spec-bullet"></div>
          <div class="spec-content">
            <h4>Interactive Concept Mind Map Studio</h4>
            <p>Auto-organizes long chapters into color-coded concept branches with connection-testing practice and high-resolution PDF export.</p>
          </div>
        </div>
      </div>

      <div class="stage-tags">
        <span class="stag">AI STUDY WORKSPACE</span>
        <span class="stag">ANIMATED LESSONS</span>
        <span class="stag">BOARD EXAM PREP</span>
        <span class="stag">WEBRTC STUDY ROOMS</span>
      </div>

      <div class="stage-actions">
        <a href="https://igradeify.vercel.app" target="_blank" rel="noopener" class="stage-btn primary">
          <span>Experience iGradeify</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
        </a>
        <button class="stage-btn secondary" onclick="openModal(0)" aria-label="Inspect iGradeify details">
          <span>Explore 7 Slides</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>
  </article>


  <!-- ==================== 02: manim-ts ==================== -->
  <article class="stage-card" id="stage-card-1" data-project="1" data-theme="manim">
    <!-- Visual Stage (Left / Center) -->
    <div class="stage-visual">
      <div class="stage-window">
        <div class="stage-window-bar">
          <div class="stage-dots"><i></i><i></i><i></i></div>
          <div class="stage-addr">manim-ts.canvas // 60fps vector morphing</div>
          <span class="stage-tag-badge">● VECTOR RUNNER</span>
        </div>
        <div class="stage-window-body">
          <div class="stage-shot-composite manim-dual-grid">
            <div class="shot-layer frame-card">
              <div class="frame-label">HERO VECTOR COMPOSITION</div>
              <img src="shots/manim_hero.png" alt="manim-ts rendered hero vector frame" loading="lazy">
            </div>
            <div class="shot-layer frame-card">
              <div class="frame-label">SMOOTH SHAPE MORPHING</div>
              <img src="shots/manim_shapes.png" alt="manim-ts rendered geometric shapes morph frame" loading="lazy">
            </div>
          </div>
          <!-- Interactive Scrub Bar Simulation -->
          <div class="manim-timeline-widget">
            <div class="timeline-ctrls">
              <span class="t-badge">▶ PLAY</span>
              <span class="t-badge">⏸ PAUSE</span>
              <span class="t-badge">1.0×</span>
              <div class="timeline-track"><div class="timeline-fill" style="width:42%"></div><div class="timeline-head" style="left:42%"></div></div>
              <span class="mono timeline-time">02.41 / 06.20s</span>
            </div>
            <div class="manim-curve-preview">
              <svg width="100%" height="48" viewBox="0 0 380 48" preserveAspectRatio="none">
                <path d="M0,38 C80,38 120,4 190,4 C260,4 300,44 380,12" fill="none" stroke="#e05545" stroke-width="2.5"/>
                <line x1="0" y1="44" x2="380" y2="44" stroke="#2a2520" stroke-width="1"/>
                <circle cx="190" cy="4" r="4.5" fill="#e05545" stroke="#f0ebe0" stroke-width="1.5"/>
              </svg>
            </div>
          </div>
          <div class="stage-shot-caption">
            ● ACTUAL FRAMES RENDERED CLIENT-SIDE BY MANIM-TS IN THE BROWSER
          </div>
        </div>
      </div>
    </div>

    <!-- Info / Specs Stack (Right) -->
    <div class="stage-info">
      <div class="stage-header">
        <div class="stage-meta">
          <span class="stage-num">02 / 06</span>
          <span class="stage-kicker">BROWSER GRAPHICS &amp; CREATIVE ENGINE</span>
        </div>
        <span class="stage-kanji">数</span>
      </div>

      <div class="stage-title-wrap">
        <h2 class="stage-title">manim-ts</h2>
        <span class="stage-status-badge live">● OPEN SOURCE LIBRARY</span>
      </div>

      <p class="stage-sub">
        A browser-native math and science animation engine bringing 3Blue1Brown-style visual explainers directly to the web — with interactive timelines, draggable objects, spring physics, and plain-English scene generation.
      </p>

      <div class="stage-specs">
        <div class="spec-item">
          <div class="spec-bullet"></div>
          <div class="spec-content">
            <h4>Browser-Native Vector Engine</h4>
            <p>Zero heavy video rendering software or Python dependencies needed — runs 100% client-side with 25+ shapes, coordinate axes, matrices, and 3D wireframe cubes at 60fps.</p>
          </div>
        </div>
        <div class="spec-item">
          <div class="spec-bullet"></div>
          <div class="spec-content">
            <h4>Glitch-Free Shape Morphing &amp; Cutouts</h4>
            <p>Smoothly transforms one geometry into another without twisted edges or jumping corners, plus vector cutouts and animated flowing vector fields.</p>
          </div>
        </div>
        <div class="spec-item">
          <div class="spec-bullet"></div>
          <div class="spec-content">
            <h4>Scrubbable Timelines &amp; Interactive Canvas</h4>
            <p>Learners can scrub to any millisecond, grab shapes with their mouse, or tweak variables with live on-screen sliders while the animation runs.</p>
          </div>
        </div>
        <div class="spec-item">
          <div class="spec-bullet"></div>
          <div class="spec-content">
            <h4>Spring Physics &amp; Live Playground</h4>
            <p>Natural spring bounce presets, stroke-by-stroke math equations, dynamic charts, and plain-English type-to-animate scene creation.</p>
          </div>
        </div>
      </div>

      <div class="stage-tags">
        <span class="stag">MATH ANIMATION</span>
        <span class="stag">60FPS VECTOR RUNNER</span>
        <span class="stag">INTERACTIVE TIMELINE</span>
        <span class="stag">TYPESCRIPT</span>
      </div>

      <div class="stage-actions">
        <a href="https://github.com/Subadeepan-Y/manim-ts" target="_blank" rel="noopener" class="stage-btn primary">
          <span>View on GitHub</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
        </a>
        <button class="stage-btn secondary" onclick="openModal(1)" aria-label="Try manim-ts playground">
          <span>Try Live Playground (6 Slides)</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>
  </article>


  <!-- ==================== 03: Duel Deck ==================== -->
  <article class="stage-card" id="stage-card-2" data-project="2" data-theme="duel">
    <!-- Visual Stage (Left / Center) -->
    <div class="stage-visual">
      <div class="stage-window">
        <div class="stage-window-bar">
          <div class="stage-dots"><i></i><i></i><i></i></div>
          <div class="stage-addr">dueldeck.vercel.app · live-squadron-arena</div>
          <span class="stage-tag-badge">● 2–5 PLAYERS</span>
        </div>
        <div class="stage-window-body">
          <div class="stage-shot-composite duel-layout">
            <div class="shot-layer duel-main-shot">
              <img src="shots/duel_home.png" alt="Duel Deck two-sided multiplayer arena home" loading="lazy">
            </div>
            <!-- Two-Sided Mid-Match Card Flip Showcase -->
            <div class="duel-flip-stage">
              <div class="dcard-display light-side">
